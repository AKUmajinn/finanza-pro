<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ================= TEXT ================= -->

    <style name="Text.Section" parent="Widget.MaterialComponents.TextView">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Text.Amount" parent="Widget.MaterialComponents.TextView">
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.SubTitle" parent="Widget.MaterialComponents.TextView">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.SubTitleRadio" parent="Widget.MaterialComponents.TextView">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:buttonTint">@color/primary</item>
    </style>

    <style name="Input.AmountText" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">numberDecimal</item>
        <item name="android:background">@null</item>
    </style>

    <style name="Input.Field1" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="android:textSize">16dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">15dp</item>
        <item name="android:background">@color/white</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:inputType">none</item>
    </style>

    <style name="Input.Calendar" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="android:textSize">16dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@color/white</item>
        <item name="android:inputType">none</item>
        <item name="android:focusable">false</item>
    </style>

    <style name="Button.fill" parent="Widget.MaterialComponents.Button">
        <item name="android:radius">8dp</item>
        <item name="backgroundTint">#007DBA</item>
        <item name="android:textStyle">bold</item>
    </style>


    <!-- ================= MENU ================= -->

    <style name="BottomNavText" parent="Widget.MaterialComponents.TextView">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.App.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.BottomNavigation</item>
        <item name="itemIconTint">@color/nav_items_selector</item>
        <item name="itemTextColor">@color/nav_items_selector</item>
        <item name="itemTextAppearanceActive">@style/BottomNavText</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavText</item>
        <item name="backgroundTint">@android:color/white</item>
    </style>

    <style name="ThemeOverlay.App.BottomNavigation" parent="">
        <item name="colorPrimary">@color/primary</item>
    </style>
</resources>
