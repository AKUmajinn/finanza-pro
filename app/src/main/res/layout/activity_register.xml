<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="@color/background"
    android:theme="@style/Theme.FinanzaPro">

    <!-- ===== AMOUNT ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_margin="20dp"
        >

        <TextView
            android:id="@+id/tvAmount"
            style="@style/Text.Section"
            android:layout_width="match_parent"
            android:layout_height="47dp"
            android:text="@string/title_amount" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <!-- Moneda -->
            <TextView
                android:id="@+id/tvCurrency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/currency"
                style="@style/Text.Amount"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/etAmount"
                app:layout_constraintTop_toTopOf="@id/etAmount"/>

            <!-- Monto editable -->
            <EditText
                android:id="@+id/etAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/default_amount"
                style="@style/Input.AmountText"

                android:padding="8dp"
                app:layout_constraintStart_toEndOf="@id/tvCurrency"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Descripcion -->
        <TextView
            android:id="@+id/tvDescripcion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_description"
            style="@style/Text.SubTitle"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="24dp" />

        <!-- Campo editable con icono -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/eticonoEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvDescripcion">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_description"
                android:maxLength="250"
                style="@style/Input.Field1"
                android:inputType="textMultiLine" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- TEXTO CATEGORÍA -->
        <TextView
            android:id="@+id/tvCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_category"
            style="@style/Text.SubTitle"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="8dp"
            tools:ignore="MissingConstraints"
            app:layout_constraintTop_toBottomOf="@id/tvDescripcion"
            />

        <!-- COMBOBOX -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:endIconMode="dropdown_menu"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvCategoria"
            >

            <AutoCompleteTextView
                android:id="@+id/actvCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_category"
                style="@style/Input.Field1"
                android:focusable="false" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- CONTENEDOR FECHA Y HORA -->
        <LinearLayout
            android:id="@+id/llfechahora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tilCategoria"
            >

            <!-- ===== FECHA ===== -->
            <LinearLayout
                android:id="@+id/cvfechahora"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <!-- Texto FECHA -->
                <TextView
                    android:id="@+id/tvFecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_date"
                    style="@style/Text.SubTitle"
                    android:layout_marginBottom="8dp" />

                <!-- DatePicker (solo fecha) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="@color/inputBorder">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFecha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Input.Calendar" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- ===== HORA ===== -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <!-- Texto HORA -->
                <TextView
                    android:id="@+id/tvHora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_time"
                    style="@style/Text.SubTitle"
                    android:layout_marginBottom="8dp" />

                <!-- TimePicker -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="@color/inputBorder">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etHora"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Input.Calendar"  />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- =========== MÉTODO DE PAGO =========== -->
        <TextView
            android:id="@+id/tvMetodoPagoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_payment"
            style="@style/Text.SubTitle"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintTop_toBottomOf="@id/llfechahora"
            app:layout_constraintStart_toStartOf="parent"
            android:textAllCaps="true" />

        <!-- Contenedor de RadioButtons -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cnMetodoPago"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:layout_constraintTop_toBottomOf="@id/tvMetodoPagoLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <RadioGroup
                android:id="@+id/rgMetodoPago"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center">

                <!-- RadioButton Efectivo -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="12dp"

                    android:layout_marginEnd="8dp">

                    <RadioButton
                        android:id="@+id/rbEfectivo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_cash"
                        style="@style/Text.SubTitleRadio"
                        android:checked="true"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:text="@string/payment_cash"
                        android:layout_marginStart="8dp"
                        app:layout_constraintStart_toEndOf="@id/rbEfectivo"
                        app:layout_constraintTop_toTopOf="@id/rbEfectivo"
                        app:layout_constraintBottom_toBottomOf="@id/rbEfectivo" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- RadioButton Tarjeta -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="12dp"

                    android:layout_marginStart="8dp">

                    <RadioButton
                        android:id="@+id/rbTarjeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_card"
                        style="@style/Text.SubTitleRadio"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"

                        android:contentDescription="@color/text_primary"
                        android:layout_marginStart="8dp"
                        app:layout_constraintStart_toEndOf="@id/rbTarjeta"
                        app:layout_constraintTop_toTopOf="@id/rbTarjeta"
                        app:layout_constraintBottom_toBottomOf="@id/rbTarjeta" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </RadioGroup>

        </com.google.android.material.card.MaterialCardView>
        <!-- ===== SAVE ===== -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/action_save" />
    </LinearLayout>


</LinearLayout>
